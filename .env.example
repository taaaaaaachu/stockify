# このファイルは (1) docker compose の ${...} 展開 と (2) ローカルの `npm run dev`(Vite)
# からのみ読まれる。本番の `node build` や `node scripts/migrate.js` は自動ロードしない
# (コンテナ内の環境変数は docker-compose.yml の environment: が渡す)。

# SQLite の保存先。ローカル開発(npm run dev / db:migrate 時にシェルで指定)用。
# ※ Docker では無視される: compose が DATABASE_PATH=/data/app.sqlite を直接渡し、
#    実体はバインドマウントでホストの ./data/app.sqlite に出る。
DATABASE_PATH=./data/app.sqlite

# 公開オリジン(CSRF/リダイレクト)。
# ※ Docker では compose 側に既定値があるため、既定と同じなら書かなくても同じ挙動。
#    別ドメインに変えたいときだけ効く。ローカル開発では ORIGIN は不要。
ORIGIN=https://stock.example.com

# --- ここから下は Docker でも .env 必須(compose に既定値が無い) ---

# Web Push(VAPID)。`npx web-push generate-vapid-keys` などで生成する。
# 未設定なら通知機能は無効(UI にその旨を表示)。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 通知評価cron(POST /api/cron/notify)の共有シークレット。
# 外部スケジューラは `Authorization: Bearer <CRON_SECRET>` を付けて叩く。
CRON_SECRET=

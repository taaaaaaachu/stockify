# SQLite の保存先(未設定なら ./data/app.sqlite)
DATABASE_PATH=./data/app.sqlite

# Web Push(VAPID)。`npx web-push generate-vapid-keys` などで生成する。
# 未設定なら通知機能は無効(UI にその旨を表示)。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# 通知評価cron(POST /api/cron/notify)の共有シークレット。
# 外部スケジューラは `Authorization: Bearer <CRON_SECRET>` を付けて叩く。
CRON_SECRET=
